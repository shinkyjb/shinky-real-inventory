const DEFAULT_ENV = {
  VITE_SUPABASE_URL: '',
  VITE_SUPABASE_ANON_KEY: ''
}

export function createClient() {
  const url = import.meta.env.VITE_SUPABASE_URL || DEFAULT_ENV.VITE_SUPABASE_URL
  const key = import.meta.env.VITE_SUPABASE_ANON_KEY || DEFAULT_ENV.VITE_SUPABASE_ANON_KEY

  if (!url || !key) {
    return null
  }

  return window?.supabase || null
}

export async function getInventory(supabase) {
  if (!supabase) return []

  const { data, error } = await supabase.from('items').select('*')
  if (error) throw error

  return (data || []).map((item) => ({
    ...item,
    images: item.images || []
  }))
}

export async function createInventoryItem(supabase, item) {
  if (!supabase) return item

  const { data, error } = await supabase
    .from('items')
    .insert([{ ...item, price: Number(item.price) }])
    .select()

  if (error) throw error
  return data?.[0] || item
}

export function getPublicUrl(path) {
  if (!path) return ''
  return path
}

export function createDemoSupabase() {
  return null
}
